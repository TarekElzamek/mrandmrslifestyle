{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/book",
      "destination": "/appointments",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}